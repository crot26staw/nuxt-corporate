{
  "name": "nuxt-corporate",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "npm run lint:eslint && npm run lint:prettier",
    "lint:eslint": "eslint .",
    "lint:prettier": "prettier . --check",
    "fix": "eslint . --fix && prettier --write --list-different .",
    "prepare": "husky",
    "pre-commit": "lint"
  },
  "lint-staged": {
    "*.{js,ts,vue,yaml}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@nuxt/eslint": "^1.15.1",
    "@nuxt/image": "^2.0.0",
    "nuxt": "^4.3.0",
    "nuxt-swiper": "^2.0.1",
    "vue": "^3.5.27",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "sass": "^1.97.3",
    "typescript": "^5.9.3",
    "vite-plugin-eslint2": "^5.0.5"
  }
}
